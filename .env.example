# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AWS EC2 (Amazon Elastic Compute Cloud) PostgreSQL Database Configuration
AWS_EC2_POSTGRES_HOST=
AWS_EC2_POSTGRES_PORT=5432
AWS_EC2_POSTGRES_DATABASE=innovista_aws_db
AWS_EC2_POSTGRES_USER=postgres
AWS_EC2_POSTGRES_PASSWORD=
AWS_EC2_POSTGRES_SSL=false
AWS_EC2_INSTANCE_ID=
AWS_EC2_REGION=us-east-1

# Optional full connection URL (alternative to discrete fields above)
# AWS_EC2_POSTGRES_URL=postgres://postgres:password@your-ec2-instance-ip.compute-1.amazonaws.com:5432/innovista_aws_db
# DATABASE_URL=

